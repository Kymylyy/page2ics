{
  "manifest_version": 3,
  "name": "page2ics",
  "version": "0.1.0",
  "description": "Pulls your booking out of a web page or email and saves it as an .ics calendar file.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save booking to calendar",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_page": "options.html"
}
